[Unit]
# Turns the Nanoleaf devices on the network off before the machine sleeps.
#
# A unit of its own and not a stop of steamos-utility-center-nanoleaf.service.
# That unit carried Conflicts=sleep.target and Before=sleep.target, so its
# ExecStop would have covered a suspend as well as a shutdown. The boot and
# the shutdown did what they say and a suspend left the lights on.
#
# Before=sleep.target with WantedBy=sleep.target is the pair that runs a unit
# ahead of a suspend, a hibernate and a hybrid sleep alike: each of those
# targets pulls in sleep.target. It is also the pair that the CEC toolkit and
# the Pegboard both use here, and both of those were seen to work on this
# machine. DefaultDependencies=no keeps this out of the ordinary boot and
# shutdown ordering, which a sleep is not part of.
#
# Log: journalctl -u steamos-utility-center-nanoleaf-sleep
Description=Turn the Nanoleaf devices on the network off before sleep
Documentation=https://github.com/caed1994/SteamOS-Utility-Center
DefaultDependencies=no
Before=sleep.target

[Service]
Type=oneshot
User=@WATCHER_USER@
ExecStart=@INSTALL_DIR@/steamos-utility-center-nanoleaf off
# The suspend waits for this unit, which is what puts the message on the wire
# before the machine goes. One call for each device with a timeout of some
# seconds, and one try: a lamp that missed it stays lit until the wake, which
# is better than a suspend that waits.
TimeoutStartSec=15

[Install]
WantedBy=sleep.target
