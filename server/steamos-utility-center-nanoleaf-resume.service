[Unit]
# Lights the Nanoleaf devices on the network again after a wake.
#
# The other half of steamos-utility-center-nanoleaf-sleep.service. That one
# turned them off on the way down, and this turns them on again.
#
# It makes the call itself. It ran `systemctl start` on the main unit before,
# which was right while that unit was stopped for the suspend. It is not
# stopped any more: the sleep unit beside this one does the off, and a start
# of a unit that is already active does nothing.
#
# suspend.target and its three companions are reached after the machine wakes,
# because each one is ordered after the service that does the sleeping. That
# is why this side names them and not sleep.target: sleep.target is reached on
# the way down.
Description=Light the Nanoleaf devices on the network again after a wake
Documentation=https://github.com/caed1994/SteamOS-Utility-Center
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
User=@WATCHER_USER@
ExecStart=@INSTALL_DIR@/steamos-utility-center-nanoleaf on
# The way up asks a device that did not answer again, five times three
# seconds apart: a lamp one second after a wake is not reachable yet.
TimeoutStartSec=40

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
