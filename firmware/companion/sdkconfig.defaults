# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.4.0 Project Minimal Configuration
#
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Larger caches for the drawing, paid for with internal memory.
#
# LVGL draws straight into the frame buffer in PSRAM, so each pixel it
# blends comes through the data cache. The code runs out of PSRAM as well,
# through the instruction cache, and since the Wi-Fi library left IRAM it
# shares that cache with the drawing. The page of the panel measured a
# frame at 39 ms of drawing, and the panel shows one every 22.5 ms.
#
# ESP-IDF names a larger cache as a way to more speed in general
# (api-guides/performance/speed). Espressif's own RGB examples keep the
# defaults, so the gain here is the one the card of the frames measures.
#
# The data cache goes from 32 to 64 KB, and the instruction cache from 16
# to 32 KB. Together they take about 48 KB of internal memory, and the
# least the panel measured free before them was 86 KB.
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

CONFIG_FREERTOS_HZ=1000
# The memory of LVGL out of PSRAM first, through main/panel_lvgl_mem.c.
# With the C library, nearly every object of LVGL came out of the internal
# memory. See main/panel_psram.h.
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
# The refresh and the touch every 15 ms, under the frame of the panel.
#
# The panel shows a frame every 22.5 ms (12 MHz, about 44 Hz), and the
# flush waits for the end of that frame. With 33 ms here a refresh began
# 33 ms after the one before it and then waited for the next frame, so a
# scroll showed its frames 22.5 and 45 ms apart in turn: an uneven step
# that a person sees. Under the frame of the panel, the next refresh
# begins as soon as the last one is on the glass, and each frame takes one
# frame of the panel, or two of them when the work does not fit in one.
#
# Nothing wakes for it while nothing changes: LVGL pauses its refresh
# timer until something is invalid, and a sleeping panel pauses the touch.
# The momentum of a swipe counts the time of the last 99 ms and not the
# number of reads, so it stays the same. See lv_indev.c.
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
# The thread that draws, "swdraw", at the top of what LVGL offers, which
# is FreeRTOS priority 4. It stood at 3, under the network task at 4, so a
# poll of the PC held a frame back. main.c holds the network task under it.
CONFIG_LV_DRAW_THREAD_PRIO=4
# GCC 15 rejects conflicting section attributes when LVGL fast memory uses IRAM.
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=n
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_"
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_IMGFONT=y
# The startup animation. lv_gif.c is in the LVGL this project pins and is
# off by default. See firmware/companion/main/panel_boot.c.
CONFIG_LV_USE_GIF=y

CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_16=y

CONFIG_LV_FONT_MONTSERRAT_14=y

CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_HEIGHT=40

# Two frame buffers, so LVGL draws into one while the display reads the
# other. Range is one to three and the board default is one. The long note
# above the display configuration in main/panel_display.c says what one of
# them cost: the tears in the startup animation. A _Static_assert there
# fails the build if this line stops taking effect.
CONFIG_BSP_LCD_RGB_BUFFER_NUMS=2

# LVGL's own log, which was not compiled in at all.
#
# LV_USE_LOG carries no default in the Kconfig of the component, so it was
# off, and every LV_LOG_ line in this firmware compiled to nothing. One of
# them is the warning in main/panel_boot.c that says the animation did not
# load, which is the one thing that explains a panel that stays black.
#
# The level stays at the WARN the component defaults to, so this is quiet.
# LV_LOG_USER prints at every level below NONE, which is how the timing of
# the animation reaches the same serial output as ESP_LOGI.
# LV_LOG_PRINTF stays off on purpose. printf from the LVGL task and
# ESP_LOG from the Wi-Fi task share one UART and no lock, and the board
# showed two lines cut into each other. main/panel_display.c registers a
# callback that hands LVGL's lines to ESP_LOG, which does take a lock.
CONFIG_LV_USE_LOG=y
# CONFIG_LV_LOG_PRINTF is not set

CONFIG_SPIRAM_XIP_FROM_PSRAM=y

CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
# The restart in VSYNC (CONFIG_LCD_RGB_RESTART_IN_VSYNC) stays off. ESP-IDF
# 5.5 finds a frame that slipped with bounce buffers on its own and
# restarts only then (lcd_rgb_panel_try_restart_transmission). The option
# restarts at every frame, and its own note says that a late restart
# shifts a frame.

# Power management, so the CPU can drop to 80 MHz while the display sleeps.
# The speed of the clock only: tickless idle and light sleep stay off. The
# RGB panel driver keeps the chip out of light sleep in any case. See
# main/panel_clock.c, which fails the build if this line stops taking
# effect.
CONFIG_PM_ENABLE=y

CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y

# CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0 is not set

# The start task, which runs app_main and is freed when it returns. The
# default of 3584 had about 700 bytes left on the board, read when app_main
# had brought the screen up and before the network. See the end of app_main,
# which says what it used.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Two time servers for the clock page, and the first one from DHCP: the
# router names one when it has one. See main/panel_time.c.
# Internal memory back for the display, at a cost the radio does not feel.
#
# The page of the panel read 43 KB of internal memory free and 22 KB at the
# least, and each change that makes the scroll faster takes some of it.
#
# The Wi-Fi library keeps its most called code in IRAM, about 19 KB on this
# build (libpp and libnet80211 in the map). Out of it, that code runs from
# the cache like the rest, and the radio is a little slower. The panel asks
# the PC a small question every few seconds, and an update takes a few
# seconds more.
#
# The buffers of Wi-Fi and lwIP come out of PSRAM first, and out of the
# internal memory only when PSRAM has none. They are what fills the
# internal memory when the radio is busy.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# lwIP on core 0 with the radio. It ran on either core, and at priority
# 18 a burst of the network took core 1 from the drawing.
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_LWIP_DHCP_GET_NTP_SRV=y

# The update over the network. A new firmware boots once on trial, and the
# bootloader goes back to the old one when the new one restarts before it
# says that it works. main/panel_ota.c says that once the PC answered. The
# bootloader is not part of an update, so this takes effect with the next
# flash over USB, which the new partition table needs as well.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
