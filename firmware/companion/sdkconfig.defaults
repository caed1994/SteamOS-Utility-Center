# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.4.0 Project Minimal Configuration
#
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_FREERTOS_HZ=1000
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=1
# GCC 15 rejects conflicting section attributes when LVGL fast memory uses IRAM.
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=n
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_"
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_USE_IMGFONT=y
# The startup animation. lv_gif.c is in the LVGL this project pins and is
# off by default. See firmware/companion/main/panel_boot.c.
CONFIG_LV_USE_GIF=y

# The picture of the game that runs, on the third page. Steam keeps a
# header.jpg for every game and the service hands it over; this is what
# reads it.
CONFIG_LV_USE_TJPGD=y
# TJPGD reads a file. It refuses bytes in memory outright unless this
# driver makes a block of memory look like a file, and it carries no
# default in the Kconfig of the component, the same hole LV_USE_LOG had.
# Without it the panel got a warning it could not print and a picture it
# could not size. See the LV_IMAGE_SRC_VARIABLE branch of decoder_info in
# lv_tjpgd.c, and firmware/companion/main/ui.c.
CONFIG_LV_USE_FS_MEMFS=y
# 77 is 'M'. The letter names the drive this driver answers for.
CONFIG_LV_FS_MEMFS_LETTER=77
# There is no cache line here, and that is measured rather than left out.
#
# A quarter of a megabyte stood here, to keep the decoded picture. It kept
# nothing. TJPGD hands LVGL one block of the picture at a time through
# get_area and never calls lv_image_decoder_add_to_cache, which is what
# puts a decode in the cache. Every other decoder in LVGL does call it;
# this one cannot, because it never holds the whole picture.
#
# So the line bought no speed and asked for 256 KB of internal memory,
# which is where lv_malloc goes: CONFIG_LV_USE_CLIB_MALLOC is set above
# and SPIRAM_USE_MALLOC is not. check_pages draws the picture with the
# cache at nought and passes.
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_16=y

CONFIG_LV_FONT_MONTSERRAT_14=y

CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_HEIGHT=40

# Two frame buffers, so LVGL draws into one while the display reads the
# other. Range is one to three and the board default is one. The long note
# above the display configuration in main/panel_display.c says what one of
# them cost: the tears in the startup animation. A _Static_assert there
# fails the build if this line stops taking effect.
CONFIG_BSP_LCD_RGB_BUFFER_NUMS=2

# LVGL's own log, which was not compiled in at all.
#
# LV_USE_LOG carries no default in the Kconfig of the component, so it was
# off, and every LV_LOG_ line in this firmware compiled to nothing. One of
# them is the warning in main/panel_boot.c that says the animation did not
# load, which is the one thing that explains a panel that stays black.
#
# The level stays at the WARN the component defaults to, so this is quiet.
# LV_LOG_USER prints at every level below NONE, which is how the timing of
# the animation reaches the same serial output as ESP_LOGI.
# LV_LOG_PRINTF stays off on purpose. printf from the LVGL task and
# ESP_LOG from the Wi-Fi task share one UART and no lock, and the board
# showed two lines cut into each other. main/panel_display.c registers a
# callback that hands LVGL's lines to ESP_LOG, which does take a lock.
CONFIG_LV_USE_LOG=y
# CONFIG_LV_LOG_PRINTF is not set

CONFIG_SPIRAM_XIP_FROM_PSRAM=y

CONFIG_LCD_RGB_ISR_IRAM_SAFE=y

CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y

# CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0 is not set
